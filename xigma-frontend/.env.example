# Browser requests in local development. Leave empty in production to use
# same-origin /api routes through Nginx.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used only by Next.js server components.
API_URL=http://localhost:8000

# Server-only reverse-geocoding credential. Never prefix this with NEXT_PUBLIC.
NESHAN_API_KEY=replace-with-a-rotated-service-key

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-a-browser-restricted-key
