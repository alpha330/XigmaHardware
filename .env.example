# Django
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost
SITE_URL=http://localhost

# PostgreSQL
DB_NAME=xigma_hardware
DB_USER=xigma
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432
# Use require or verify-full when connecting to a TLS-enabled external DB.
DB_SSLMODE=prefer

# Production defaults expect TLS termination; staging defaults to plain HTTP.
# Override these only when the deployment topology differs from those defaults.
# SECURE_SSL_REDIRECT=true
# SECURE_COOKIES=true
# SECURE_HSTS_SECONDS=31536000

# Redis
REDIS_PASSWORD=replace-with-a-url-safe-redis-password
REDIS_EXTERNAL_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/1

# Public ports
HTTP_PORT=80
BACKEND_PORT=8000
DB_EXTERNAL_PORT=5432

# Frontend
# Leave empty behind the included Nginx proxy (same-origin /api requests).
NEXT_PUBLIC_API_URL=
NESHAN_API_KEY=replace-with-a-rotated-service-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-a-browser-restricted-key

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@xigmahardware.com

# SMS
GHASEDAK_API_KEY=
GHASEDAK_LINE_NUMBER=3000505
GHASEDAK_OTP_TEMPLATE=XigmaAuth

# Observability
SENTRY_DSN=

# Development tools
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
FLOWER_USER=admin
FLOWER_PASSWORD=replace-with-a-strong-password
FLOWER_PORT=5555
